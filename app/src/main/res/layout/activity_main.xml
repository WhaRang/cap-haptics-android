<?xml version="1.0" encoding="utf-8"?>
<!--
    Padding on this ScrollView is applied at runtime from the window insets (see
    MainActivity.applyWindowInsets). targetSdk 35+ draws edge to edge, so without that the
    first control on the screen sits underneath the status bar.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tierLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/forced_tier"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/tierGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tierAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tier_auto" />

            <RadioButton
                android:id="@+id/tierT1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_t1" />

            <RadioButton
                android:id="@+id/tierT2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_t2" />

            <RadioButton
                android:id="@+id/tierT3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_t3" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pattern_header"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intensityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/intensityBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <LinearLayout
            android:id="@+id/patternGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/view_feedback_header"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/viewFeedbackGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/predefined_header"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTick"
                style="@style/GridButton"
                android:text="@string/effect_tick" />

            <Button
                android:id="@+id/btnClick"
                style="@style/GridButton"
                android:text="@string/effect_click" />

            <Button
                android:id="@+id/btnDoubleClick"
                style="@style/GridButton"
                android:text="@string/effect_double" />

            <Button
                android:id="@+id/btnHeavyClick"
                style="@style/GridButton"
                android:text="@string/effect_heavy" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/primitive_header"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrimClick"
                style="@style/GridButton"
                android:text="@string/prim_click" />

            <Button
                android:id="@+id/btnPrimTick"
                style="@style/GridButton"
                android:text="@string/prim_tick" />

            <Button
                android:id="@+id/btnPrimLowTick"
                style="@style/GridButton"
                android:text="@string/prim_low_tick" />

            <Button
                android:id="@+id/btnPrimThud"
                style="@style/GridButton"
                android:text="@string/prim_thud" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrimQuickRise"
                style="@style/GridButton"
                android:text="@string/prim_quick_rise" />

            <Button
                android:id="@+id/btnPrimSlowRise"
                style="@style/GridButton"
                android:text="@string/prim_slow_rise" />

            <Button
                android:id="@+id/btnPrimQuickFall"
                style="@style/GridButton"
                android:text="@string/prim_quick_fall" />

            <Button
                android:id="@+id/btnPrimSpin"
                style="@style/GridButton"
                android:text="@string/prim_spin" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/composition_header"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCompRiseClick"
                style="@style/GridButton"
                android:text="@string/comp_rise_click" />

            <Button
                android:id="@+id/btnCompHeartbeat"
                style="@style/GridButton"
                android:text="@string/comp_heartbeat" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/raw_header"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/durationBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="500"
            android:progress="40" />

        <TextView
            android:id="@+id/amplitudeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/amplitudeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="200" />

        <Button
            android:id="@+id/btnOneShot"
            style="@style/WideButton"
            android:text="@string/play_one_shot" />

        <Button
            android:id="@+id/btnPulses"
            style="@style/WideButton"
            android:text="@string/play_pulses" />

        <Button
            android:id="@+id/btnRamp"
            style="@style/WideButton"
            android:text="@string/play_ramp" />

        <Button
            android:id="@+id/btnCancel"
            style="@style/WideButton"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btnFuzz"
            style="@style/WideButton"
            android:layout_marginTop="16dp"
            android:text="@string/fuzz" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
